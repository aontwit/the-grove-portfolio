{
  "name": "the-grove",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "pnpm geometry:check && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "geometry:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/geometry-check.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/a11y.spec.ts --no-deps",
    "test:visual": "playwright test e2e/visual.spec.ts --no-deps",
    "test:visual:update": "playwright test e2e/visual.spec.ts --no-deps --update-snapshots",
    "lighthouse": "node scripts/lighthouse.mjs",
    "render:stills": "node scripts/render-stills.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "class-variance-authority": "^0.7.1",
    "framer-motion": "^13.4.6",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.49.0",
    "next": "^15.5.27",
    "next-intl": "^4.14.8",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
